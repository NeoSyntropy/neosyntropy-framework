# Copy to tests/.env and fill values (tests/.env is gitignored).

NEOSYNTROPY_API_KEY=
# Optional. Cookbook examples create a project per run when this is unset.
NEOSYNTROPY_PROJECT_ID=
# Local backend (scripts/dev.ps1). Override for production.
NEOSYNTROPY_API_URL=http://127.0.0.1:8000

EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Create once in EmailJS dashboard (shell: to_email / subject / html_body), then paste id here.
EMAILJS_TEMPLATE_ID=
