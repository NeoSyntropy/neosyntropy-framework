"""SQLAlchemy model for {CONCEPT} objects registered by the SDK."""
from __future__ import annotations

import uuid
from datetime import datetime

from sqlalchemy import DateTime, ForeignKey, Index, JSON, String, Text, UniqueConstraint, func
from sqlalchemy.dialects.postgresql import UUID
from sqlalchemy.orm import Mapped, mapped_column

from src.base import Base


class {CONCEPT_LABEL}(Base):
    __tablename__ = "{CONCEPT}s"
    __table_args__ = (
        UniqueConstraint(
            "project_id", "{CONCEPT_NATURAL_KEY}",
            name="uq_{CONCEPT}s_project_{CONCEPT_NATURAL_KEY}",
        ),
        Index("ix_{CONCEPT}s_project_last_seen", "project_id", "last_seen_at"),
    )

    id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4
    )
    project_id: Mapped[uuid.UUID] = mapped_column(
        ForeignKey("projects.id", ondelete="CASCADE"), index=True
    )
    {CONCEPT_NATURAL_KEY}: Mapped[str] = mapped_column(String(160))
    description: Mapped[str | None] = mapped_column(Text)
    manifest: Mapped[dict] = mapped_column(JSON, default=dict)
    first_seen_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True), server_default=func.now()
    )
    last_seen_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True), server_default=func.now()
    )
